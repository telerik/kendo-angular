{
  "name": "angular-electron",
  "version": "14.0.0",
  "description": "Angular 21 with Electron 27 (Typescript + SASS + Hot Reload)",
  "homepage": "https://github.com/maximegris/angular-electron",
  "author": {
    "name": "Maxime GRIS",
    "email": "maxime.gris@gmail.com"
  },
  "keywords": [
    "angular",
    "angular 21",
    "electron",
    "electron 27",
    "nodejs",
    "typescript",
    "jest",
    "playwright",
    "eslint",
    "sass",
    "windows",
    "mac",
    "linux"
  ],
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "start": "npm-run-all -p electron:serve ng:serve",
    "ng:serve": "ng serve -c web -o",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "web:build": "npm run build -- -c web-production",
    "electron": "electron",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "electron:local": "npm run build:prod && electron .",
    "electron:build": "npm run build:prod && electron-builder build --publish=never",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "npm run build:prod && playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/language-service": "21.2.26",
    "@angular/localize": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "@progress/kendo-angular-buttons": "25.3.0",
    "@progress/kendo-angular-charts": "25.3.0",
    "@progress/kendo-angular-common": "25.3.0",
    "@progress/kendo-angular-dateinputs": "25.3.0",
    "@progress/kendo-angular-dialog": "25.3.0",
    "@progress/kendo-angular-dropdowns": "25.3.0",
    "@progress/kendo-angular-excel-export": "25.3.0",
    "@progress/kendo-angular-grid": "25.3.0",
    "@progress/kendo-angular-icons": "25.3.0",
    "@progress/kendo-angular-inputs": "25.3.0",
    "@progress/kendo-angular-intl": "25.3.0",
    "@progress/kendo-angular-l10n": "25.3.0",
    "@progress/kendo-angular-label": "25.3.0",
    "@progress/kendo-angular-layout": "25.3.0",
    "@progress/kendo-angular-navigation": "25.3.0",
    "@progress/kendo-angular-pdf-export": "25.3.0",
    "@progress/kendo-angular-popup": "25.3.0",
    "@progress/kendo-angular-progressbar": "25.3.0",
    "@progress/kendo-angular-treeview": "25.3.0",
    "@progress/kendo-angular-utils": "25.3.0",
    "@progress/kendo-data-query": "1.7.4",
    "@progress/kendo-drawing": "1.25.7",
    "@progress/kendo-licensing": "1.13.0",
    "@progress/kendo-svg-icons": "5.5.0",
    "@progress/kendo-theme-meridian": "14.8.0",
    "hammerjs": "2.0.8",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "21.1.0",
    "@angular-builders/jest": "21.0.4",
    "@angular-devkit/build-angular": "21.2.29",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "@playwright/test": "1.55.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "conventional-changelog-cli": "3.0.0",
    "electron": "27.2.0",
    "electron-builder": "24.9.1",
    "electron-debug": "3.2.0",
    "electron-reloader": "1.2.3",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsdoc": "46.9.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jest": "30.5.2",
    "node-polyfill-webpack-plugin": "2.0.1",
    "npm-run-all": "4.1.5",
    "playwright": "1.55.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "wait-on": "7.2.0",
    "webdriver-manager": "12.1.9"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "browserslist": [
    "chrome 114"
  ]
}
